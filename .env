# ---------------------------------------------------------------------------
# Docker configuration for the Mini-PA-Prep order management system.
# Change a port here if it clashes with something already running on your PC.
# These defaults were picked because 80/3306/8080/8081 were already in use.
# ---------------------------------------------------------------------------

# Port on YOUR computer where the web app is served
APP_PORT=8100

# Port on YOUR computer for the phpMyAdmin database UI
PHPMYADMIN_PORT=8101

# Port on YOUR computer to connect to MySQL directly (e.g. with DBeaver/CLI)
DB_PORT=3310

# Database name + credentials (used by the app, MySQL and phpMyAdmin)
MYSQL_DATABASE=minipaprep
MYSQL_USER=minipa
MYSQL_PASSWORD=minipa
MYSQL_ROOT_PASSWORD=root
